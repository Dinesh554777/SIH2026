# SIH2026 backend configuration — copy to `.env` (DO NOT commit `.env`).
# All values here must remain placeholders; put real secrets only in your local `.env`.

# ---- Runtime environment ----
ENVIRONMENT=development                    # development | test | production

# ---- Data / model artifacts (optional; defaults = ./data and ./models) ----
# DATA_DIR=
# MODEL_DIR=
# SIH_DATA_ROOT=                           # legacy aliases (prefer MODEL_DIR/DATA_DIR)
# SIH_MODELS_ROOT=

# ---- PostgreSQL (Phase I-A database layer; NOT wired into the app yet) ----
# App role + dev/test DBs are created by scripts/setup_pg_db.sql (run once as postgres).
# DATABASE_URL=postgresql+psycopg2://sih2026_app:CHANGE_ME@127.0.0.1:5432/sih2026_app
# DATABASE_URL_TEST=postgresql+psycopg2://sih2026_app:CHANGE_ME@127.0.0.1:5432/sih2026_app_test
# PGUSER=sih2026_app                       # used only if DATABASE_URL is unset
# PGPASSWORD=CHANGE_ME
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=sih2026_app

# ---- Groq (later phase only — prepared here, never used yet) ----
# GROQ_API_KEY=                            # leave empty until the Groq phase

# ---- Phase J1: live observation ingestion (operational live mode) ----
# FORECAST_MODE stays 'historical' unless an operator turns on live mode.
FORECAST_MODE=historical                   # historical | live  (default historical)
LIVE_DATA_SOURCE=imd                       # imd | mock (mock is TEST-ONLY, gate-kept)
# LIVE_SOURCE_URL=                         # optional override; default = verified IMD Pune
                                           # POST RF25.php endpoint (operational)
LIVE_REQUEST_TIMEOUT_SECONDS=30            # per-request network timeout
LIVE_MAX_RETRIES=2                         # bounded bursts for transient failures (0-10)
MAX_OBSERVATION_AGE_HOURS=48               # freshness threshold
# LIVE_ALLOW_MOCK=0                        # 1 = allow the deterministic MOCK/TEST-ONLY source
FUTURE_TOLERANCE_SECONDS=3600              # clock-skew allowance for 'future' rejection